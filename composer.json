{
    "name": "agent001/sylius-ai-assistant-plugin",
    "type": "sylius-plugin",
    "description": "Agent001 AI Customer Support Assistant for Sylius eCommerce.",
    "license": "MIT",
    "keywords": [
        "sylius",
        "sylius-plugin",
        "ai",
        "chatbot",
        "customer-support",
        "agent001"
    ],
    "authors": [
        {
            "name": "Agent001 Team",
            "homepage": "https://agent001.ai"
        }
    ],
    "require": {
        "php": "^8.2",
        "sylius/sylius": "~2.2.13 || ^2.3.3",
        "symfony/http-client": "^6.4 || ^7.4",
        "symfony/messenger": "^6.4 || ^7.4",
        "symfony/rate-limiter": "^6.4 || ^7.4"
    },
    "require-dev": {
        "behat/behat": "^3.16",
        "behat/mink": "^1.11",
        "behat/mink-browserkit-driver": "^2.2",
        "friends-of-behat/mink-extension": "^2.7",
        "friends-of-behat/page-object-extension": "^0.3",
        "friends-of-behat/symfony-extension": "^2.6",
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^1.12",
        "phpstan/phpstan-doctrine": "^1.4",
        "phpstan/phpstan-webmozart-assert": "^1.2",
        "phpunit/phpunit": "^10.5",
        "sylius-labs/coding-standard": "^4.4",
        "sylius/sylius-rector": "^2.0",
        "sylius/test-application": "^2.0.0@alpha",
        "symfony/browser-kit": "^6.4 || ^7.4",
        "symfony/css-selector": "^6.4 || ^7.4",
        "symfony/debug-bundle": "^6.4 || ^7.4",
        "symfony/dom-crawler": "^6.4 || ^7.4",
        "symfony/dotenv": "^6.4 || ^7.4",
        "symfony/intl": "^6.4 || ^7.4",
        "symfony/runtime": "^6.4 || ^7.4",
        "symfony/web-profiler-bundle": "^6.4 || ^7.4",
        "symfony/webpack-encore-bundle": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "Agent001\\SyliusAiAssistantPlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Agent001\\SyliusAiAssistantPlugin\\": ["tests/", "tests/TestApplication/src/"]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false,
            "php-http/discovery": false,
            "symfony/flex": true,
            "symfony/runtime": true
        }
    },
    "extra": {
        "symfony": {
            "require": "^7.4"
        },
        "public-dir": "vendor/sylius/test-application/public"
    },
    "scripts": {
        "database-reset": [
            "vendor/bin/console doctrine:database:drop --force --if-exists",
            "vendor/bin/console doctrine:database:create",
            "vendor/bin/console doctrine:migrations:migrate -n",
            "vendor/bin/console sylius:fixtures:load -n"
        ],
        "frontend-clear": [
            "cd vendor/sylius/test-application && yarn install && yarn build",
            "vendor/bin/console assets:install"
        ],
        "test-app-init": [
            "@database-reset",
            "@frontend-clear"
        ]
    }
}
